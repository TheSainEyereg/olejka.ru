{
	"tasks": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig .`/tsconfig.json --watch",
		"start": "deno run --allow-env --allow-read --allow-net --unstable-sloppy-imports ./build"
	},
	"lint": {
		"include": [
			"src/"
		]
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 4,
		"lineWidth": 100,
		"semiColons": true,
		"singleQuote": false,
		"include": [
			"src/"
		]
	}
}